{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train 5-Fold DINOv3 Small (TTA Enabled)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--data_path", "wide.csv",
                "--backbone", "vit_small_patch16_dinov3_qkvb",
                "--img_size", "384",
                "--batch_size", "8",
                "--grad_accum", "2",
                "--stage1_epochs", "8",
                "--stage2_epochs", "25",
                "--n_folds", "5",
                "--seed", "223",
                "--use_tta"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "C:/Users/Precision/anaconda3/envs/audio_signal_processing/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "Inference & Generate Submission (TTA Enabled)",
            "type": "debugpy",
            "request": "launch",
