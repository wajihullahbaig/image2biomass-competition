{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train 5-Fold Dual-Stream DINO",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--backbone", "vit_base_patch14_dinov2",
                "--img_size", "512",
                "--batch_size", "8",
                "--grad_accum", "2",
                "--stage1_epochs", "8",
                "--stage2_epochs", "26",
                "--n_folds", "5"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "C:/Users/Precision/anaconda3/envs/audio_signal_processing/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "Train Fast Debug (2+3 Epochs)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--backbone", "vit_base_patch14_dinov2",
                "--img_size", "512",
                "--batch_size", "8",
                "--stage1_epochs", "2",
                "--stage2_epochs", "3",
                "--n_folds", "5"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "C:/Users/Precision/anaconda3/envs/audio_signal_processing/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "Run Multi-Fold Inference (Generate Submission)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/inference.py",
            "args": [
                "--model_dir", "models",
                "--test_csv", "test.csv",
                "--output_csv", "submission.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "C:/Users/Precision/anaconda3/envs/audio_signal_processing/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "Python: Current Active File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "C:/Users/Precision/anaconda3/envs/audio_signal_processing/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": true
        }
    ]
